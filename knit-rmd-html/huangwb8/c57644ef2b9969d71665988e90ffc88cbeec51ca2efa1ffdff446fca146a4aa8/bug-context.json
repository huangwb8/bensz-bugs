    "reproduction_steps": [
      "确保 Rscript 可用且 Pandoc 不在 PATH。",
      "执行 knit_rmd_html.py 对一个 Rmd 进行渲染。"
    ],
    "severity": "minor",
    "summary": "Pandoc 自动引导失败后未提供可用渲染路径",
