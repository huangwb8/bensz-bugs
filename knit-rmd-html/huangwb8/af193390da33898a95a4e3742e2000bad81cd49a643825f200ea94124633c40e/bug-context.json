  "bug": {
    "actual_behavior": "The render subprocess starts, but Python subprocess text decoding raises UnicodeDecodeError before the wrapper can report the R result.",
    "additional_notes": null,
    "evidence": [
      "UnicodeDecodeError: 'gbk' codec cannot decode byte 0x80 in subprocess stdout."
    ],
    "expected_behavior": "The wrapper should decode Rscript output robustly and report the actual render result.",
    "impact": "这是由 skill 设计缺陷导致的真实环境问题，需要纳入后续修复闭环。",
    "is_skill_design_defect": true,
    "reproduction_steps": [
      "Run knit_rmd_html.py from a Windows GBK locale after pandoc is available.",
      "Render an Rmd whose R subprocess emits UTF-8 output."
    ],
    "severity": "medium",
    "summary": "Windows wrapper decodes R subprocess output with GBK and crashes on UTF-8 bytes",
    "workaround": "Run the wrapper with Python -X utf8 so subprocess text decoding uses UTF-8."
