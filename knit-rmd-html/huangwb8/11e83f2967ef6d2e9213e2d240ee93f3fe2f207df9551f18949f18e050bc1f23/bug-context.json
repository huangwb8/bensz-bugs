  "bug": {
    "actual_behavior": "subprocess.run uses text mode without an explicit encoding, so Windows GBK decoding raises UnicodeDecodeError on UTF-8 R output.",
    "additional_notes": null,
    "evidence": [
      "UnicodeDecodeError from subprocess communication while decoding Rscript stdout with the GBK codec."
    ],
    "expected_behavior": "The wrapper should decode Rscript output robustly and finish rendering when the report emits UTF-8 bytes.",
    "impact": "这是由 skill 设计缺陷导致的真实环境问题，需要纳入后续修复闭环。",
    "is_skill_design_defect": true,
    "reproduction_steps": [
      "Run knit_rmd_html.py on Windows with Rscript and Pandoc available.",
      "Render an Rmd whose R startup or package output contains UTF-8 bytes not valid in GBK."
    ],
    "severity": "important",
    "summary": "Windows wrapper decodes R render output with the default GBK codec",
    "workaround": "Run the wrapper with Python UTF-8 mode using python -X utf8."
  },
