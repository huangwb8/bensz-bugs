{
  "bug": {
    "actual_behavior": "subprocess.run text mode uses the default GBK decoder and raises UnicodeDecodeError when R emits UTF-8 output, masking the render result.",
    "additional_notes": null,
    "evidence": [
      "UnicodeDecodeError: GBK codec cannot decode a UTF-8 byte while subprocess stdout is being read."
    ],
    "expected_behavior": "The render wrapper should capture R subprocess output robustly on Windows and return the real render status.",
    "impact": "这是由 skill 设计缺陷导致的真实环境问题，需要纳入后续修复闭环。",
    "is_skill_design_defect": true,
    "reproduction_steps": [
      "Run knit_rmd_html.py on a UTF-8 R Markdown report from a Windows GBK console."
    ],
    "severity": "important",
    "summary": "Python wrapper decodes R render output with Windows GBK and crashes on UTF-8 bytes",
    "workaround": "Run the wrapper with PYTHONUTF8=1 so Python subprocess text decoding uses UTF-8 mode."
  },
