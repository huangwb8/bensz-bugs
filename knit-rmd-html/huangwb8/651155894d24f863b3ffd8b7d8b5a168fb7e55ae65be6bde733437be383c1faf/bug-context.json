  "bug": {
    "actual_behavior": "After Pandoc and Rscript are found, subprocess output decoding raises UnicodeDecodeError with the Windows GBK codec.",
    "additional_notes": null,
    "evidence": [
      "UnicodeDecodeError: gbk codec cannot decode byte 0x80 while reading subprocess stdout."
    ],
    "expected_behavior": "The wrapper should decode subprocess output robustly and complete rendering when R emits UTF-8 text.",
    "impact": "这是由 skill 设计缺陷导致的真实环境问题，需要纳入后续修复闭环。",
    "is_skill_design_defect": true,
    "reproduction_steps": [
      "Expose local Pandoc and Rscript on PATH.",
      "Run knit_rmd_html.py on an Rmd whose startup emits UTF-8 text."
    ],
    "severity": "medium",
    "summary": "Windows wrapper decodes UTF-8 R render output as GBK and crashes",
    "workaround": "Run Python in UTF-8 mode or invoke the same rmarkdown::render expression directly with UTF-8 locale variables."
  },
